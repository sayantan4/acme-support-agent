# --- App ---
# Postgres, one database per service (createdb gmail_webhooks; createdb auth; createdb ai_analyzer)
DATABASE_URL=postgresql+psycopg://localhost:5432/gmail_webhooks
AUTH_DATABASE_URL=postgresql+psycopg://localhost:5432/auth
ANALYZER_DATABASE_URL=postgresql+psycopg://localhost:5432/ai_analyzer
BASE_URL=http://localhost:8000

# --- Google OAuth (Desktop/Web client JSON downloaded from GCP console) ---
GOOGLE_CLIENT_SECRETS_FILE=./client_secret.json
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback
# readonly to read the inbox, send to reply in the thread
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# --- Pub/Sub ---
# Full topic name that Gmail publishes to
PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-inbox
# Pull mode (app.cli pull): subscription the worker reads from
PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT_ID/subscriptions/gmail-inbox-pull

# --- Push mode only (POST /pubsub/push) ---
# Verify the OIDC JWT Pub/Sub attaches to push requests (disable only for local dev)
PUBSUB_VERIFY_JWT=true
# Audience configured on the push subscription (defaults to the push endpoint URL)
PUBSUB_AUDIENCE=https://your.domain.com/pubsub/push
# Service account the push subscription authenticates as
PUBSUB_SA_EMAIL=gmail-pusher@YOUR_PROJECT_ID.iam.gserviceaccount.com

# --- Security ---
# Fernet key used to encrypt stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# How many recent inbox messages to process on a full resync (stale historyId)
FULL_SYNC_MAX_MESSAGES=50

# --- Summary pipeline ---
REDIS_URL=redis://localhost:6380/0
# ai_analyzer (C1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# the scope gate's model
SCOPE_MODEL=gpt-5.4-nano
# true: send replies through Gmail. false (default): store them only
SEND_REPLIES=false

# --- Docker only (docker-compose.yml sets the rest) ---
# Comma-separated CIDRs the internal APIs trust besides localhost
# TRUSTED_NETWORKS=
# AUTH_HOST=127.0.0.1
# TOOLSVC_HOST=127.0.0.1
